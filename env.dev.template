# =============================================================================
# Kobload Development Environment Configuration
# =============================================================================
# Copy this file to .env.dev to use these settings in dev mode:
#   cp env.dev.template .env.dev
# This file is loaded by docker-compose.dev.yml.
#
# To apply changes: docker compose -f docker-compose.dev.yml up -d --build
# =============================================================================

# -----------------------------------------------------------------------------
# Admin Authentication
# -----------------------------------------------------------------------------
# Fixed admin password for dev (avoids needing to extract from logs)
# Uses DEV_ADMIN_PASSWORD (same env var as Kobbler for consistency)
DEV_ADMIN_PASSWORD=kob-dev-password

# Admin email (also used as username)
ADMIN_EMAIL=admin@localhost

# -----------------------------------------------------------------------------
# Dev Mode Settings
# -----------------------------------------------------------------------------
# Enable dev mode features
DEV_MODE=1

# Auto-restore from dev snapshot on startup (if snapshot exists)
# Only restores on fresh database (no users). To reset: docker compose down -v
DEV_AUTO_RESTORE=1

# -----------------------------------------------------------------------------
# Kobload API Key
# -----------------------------------------------------------------------------
# API key for authenticating requests to Kobload
# Used by Kobbler to communicate with Kobload
KOBLOAD_API_KEY=dev-kobload-api-key

# Public URL for Kobload (used in callbacks)
KOBLOAD_PUBLIC_URL=http://localhost:7080

# -----------------------------------------------------------------------------
# Kobbler Integration
# -----------------------------------------------------------------------------
# There is nothing to set here. Kobbler calls Kobload at KOBLOAD_PUBLIC_URL
# using KOBLOAD_API_KEY, and supplies its own callback URL on each request.
# Watch-match events travel over the shared NATS bus.

# -----------------------------------------------------------------------------
# Prowlarr Integration (optional)
# -----------------------------------------------------------------------------
# Prowlarr URL and API key for indexer searches
# Get API key from Prowlarr: Settings -> General -> Security -> API Key
PROWLARR_BASE_URL=
PROWLARR_API_KEY=

# -----------------------------------------------------------------------------
# Logging
# -----------------------------------------------------------------------------
RUST_LOG=info,kobload_api=debug

# -----------------------------------------------------------------------------
# Port Overrides (optional)
# -----------------------------------------------------------------------------
# KOBLOAD_PORT=7080
# KOBLOAD_WEB_PORT=5174
