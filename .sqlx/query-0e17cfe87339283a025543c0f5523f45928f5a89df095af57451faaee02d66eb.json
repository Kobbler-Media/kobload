  "query": "\n        SELECT id, watch_pattern_id AS \"watch_pattern_id!\", release_guid, release_title,\n               match_score, matched_pattern\n        FROM watch_matches\n        WHERE action IN ('downloaded', 'upgrade') AND NOT rejected\n          AND watch_pattern_id IS NOT NULL\n          AND created_at > $1\n        ORDER BY created_at\n        ",
