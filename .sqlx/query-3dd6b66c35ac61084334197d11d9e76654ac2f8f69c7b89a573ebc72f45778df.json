  "query": "\n        SELECT\n            id,\n            provider_call_id,\n            release_title,\n            release_guid,\n            release_size,\n            protocol,\n            indexer_name,\n            match_score,\n            matched_pattern,\n            match_mode,\n            quality_score,\n            quality_score_breakdown,\n            total_score,\n            parsed_quality,\n            structural_result,\n            match_explanation,\n            decision,\n            decision_reason,\n            episode_key,\n            is_best,\n            release_data\n        FROM decision_log_releases\n        WHERE session_id = $1\n        ORDER BY is_best DESC, total_score DESC NULLS LAST, created_at\n        ",
