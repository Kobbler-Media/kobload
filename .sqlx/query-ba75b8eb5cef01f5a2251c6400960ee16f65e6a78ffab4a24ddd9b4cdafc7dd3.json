  "query": "\n        SELECT d.id, d.external_id AS \"external_id!\"\n        FROM downloads d\n        JOIN download_clients c ON c.id = d.download_client_id\n        WHERE c.client_type = $1\n          AND d.status IN ('queued', 'downloading')\n          AND d.external_id IS NOT NULL\n        ",
