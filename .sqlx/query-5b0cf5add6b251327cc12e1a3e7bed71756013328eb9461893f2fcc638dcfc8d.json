  "query": "\n        SELECT release_key, title, size, published_at, indexer_source_id, indexer, protocol,\n               download_url, magnet_url, info_hash\n        FROM release_sightings\n        WHERE seen_at >= $1 AND title ILIKE ANY($2)\n        ",
