  "query": "\n        UPDATE downloads\n        SET import_confirmed_at = NOW(), updated_at = NOW()\n        WHERE id = $1 AND import_confirmed_at IS NULL\n          AND status NOT IN ('failed', 'cancelled')\n        RETURNING download_client_id, external_id, protocol, client_data\n        ",
