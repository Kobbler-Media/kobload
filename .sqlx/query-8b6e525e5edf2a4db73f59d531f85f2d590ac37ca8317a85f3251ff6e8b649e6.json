  "query": "\n        SELECT info_hash, original_title, size, magnet_url, first_seen\n        FROM torrent_hash_index\n        WHERE to_tsvector('english', original_title) @@ to_tsquery('english', $1)\n          AND first_seen >= $2\n        ORDER BY first_seen DESC\n        LIMIT $3\n        ",
