{
  "db_name": "PostgreSQL",
  "query": "SELECT info_hash, imdb_id, tmdb_id, original_title, parsed_title,\n                  year, quality, size, magnet_url, source, seeders,\n                  season, episodes\n           FROM torrent_hash_index\n           WHERE imdb_id = $1\n             AND (\n               $2::smallint IS NULL\n               OR (\n                 season = $2\n                 AND (\n                   $3::smallint IS NULL\n                   OR episodes @> ARRAY[$3]::smallint[]\n                 )\n               )\n             )\n           ORDER BY size DESC NULLS LAST\n           LIMIT 500",
