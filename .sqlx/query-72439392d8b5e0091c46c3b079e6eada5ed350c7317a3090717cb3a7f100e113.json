{
  "db_name": "PostgreSQL",
  "query": "\n        SELECT id, status, external_id\n        FROM downloads\n        WHERE download_url = $1\n          AND status NOT IN ('failed', 'cancelled')\n          AND created_at > NOW() - make_interval(hours => $2)\n        ORDER BY created_at DESC\n        LIMIT 1\n        ",
