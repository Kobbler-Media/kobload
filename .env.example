# Copy to .env and edit. Every variable here is consumed by docker-compose.yml.
#   cp .env.example .env

# --- Images ------------------------------------------------------------------
# `latest` follows main; a release (`0.1`, or exactly `0.1.0`) stays put until
# you change it. Releases: https://github.com/Kobbler-Media/kobload/releases
KOBLOAD_TAG=latest

# --- Paths -------------------------------------------------------------------
# koblibs is a shared Rust/JS workspace that Kobload depends on as a sibling
# checkout (not yet published to crates.io/npm). Clone it next to this repo.
KOBLIBS_DIR=../koblibs

# Host directory holding your download client's completed downloads. Kobload
# reads files from here to stream them on to Kobbler. Defaults to a repo-local
# folder so the stack starts without touching anything outside the checkout.
KOBLOAD_DOWNLOADS=./data/downloads

# --- Database ----------------------------------------------------------------
POSTGRES_PASSWORD=kobload

# --- NATS --------------------------------------------------------------------
# Shared message bus between Kobload and Kobbler. Required — compose refuses
# to start without it. Use the same value on both services.
NATS_TOKEN=
NATS_MONITOR_PORT=8223
# Point at an external NATS instead of the bundled one:
# NATS_URL=nats://token@nats.example.com:4222

# --- Kobload API -------------------------------------------------------------
# Shared secret Kobbler presents when calling this API. Generate one with
# `openssl rand -hex 32` and set the same value on the Kobbler side.
KOBLOAD_API_KEY=

# Public base URL of THIS service. Kobload hands it out in callbacks and file
# links, so it must be reachable from Kobbler.
KOBLOAD_PUBLIC_URL=http://localhost:7080

# Optional extra CORS origin for the web UI (the bundled nginx proxy means you
# usually do not need this).
KOBLOAD_CORS_ORIGIN=

KOBLOAD_PORT=7080
KOBLOAD_WEB_PORT=5174

# --- Admin account -----------------------------------------------------------
# Created on first boot. Leave the password blank to have one generated and
# printed to the API logs.
ADMIN_EMAIL=admin@localhost
ADMIN_PASSWORD=

# --- Indexers (optional) -----------------------------------------------------
# Prowlarr can be used as an indexer aggregator instead of configuring each
# indexer directly in the Kobload UI.
PROWLARR_BASE_URL=
PROWLARR_API_KEY=

# --- Logging -----------------------------------------------------------------
RUST_LOG=info,kobload_api=info

# --- bitmagnet DHT indexer (optional) ----------------------------------------
# Only used by the bitmagnet service, which is commented out in
# docker-compose.yml and enabled by default in docker-compose.dev.yml.
TMDB_API_KEY=
BITMAGNET_WEB_PORT=3333
BITMAGNET_DHT_PORT=3334
# Postgres memory for the bitmagnet overlay; see docker/postgres-tuning.conf.
# Leave unset for stock defaults. Suggested for a 16GB host: 3GB / 10GB / 4GB.
PG_SHARED_BUFFERS=
PG_EFFECTIVE_CACHE_SIZE=
PG_MAX_WAL_SIZE=

# --- Tests -------------------------------------------------------------------
# Host port for the throwaway Postgres in docker-compose.test.yml.
KOBLOAD_TEST_DB_PORT=5434

# Further API settings (archive tool paths, Cardigann definition dirs, the
# experimental koblem UI) are not passed through by docker-compose.yml; see
# "Advanced" under Configuration in README.md.
